{
	"name": "Molecular Lennard-Jones Simulation",
	"build": {
		"dockerfile": "Dockerfile"
	},
	"features": {},
	"customizations": {
		"vscode": {
			"extensions": [
				"rust-lang.rust-analyzer",
				"vadimcn.vscode-lldb"
			],
			"settings": {
				"rust-analyzer.numThreads": 2,
				"rust-analyzer.procMacro.enable": false,
				"rust-analyzer.cargo.buildScripts.enable": false,
				"files.watcherExclude": {
					"**/target/**": true
				}
			}
		}
	},
	"containerEnv": {
		"CARGO_REGISTRIES_CRATES_IO_PROTOCOL": "sparse",
		"CARGO_NET_GIT_FETCH_WITH_CLI": "true"
	},
	"mounts": [
		"type=volume,source=cargo-registry-cache,target=/usr/local/cargo/registry",
		"type=volume,source=cargo-git-cache,target=/usr/local/cargo/git"
	],
	"postCreateCommand": "rustup component add rustfmt clippy rust-analyzer",
	"remoteUser": "vscode"
}
