{
    "version": "2.0.0",
    "tasks": [

        {
            "label": "Rust: Run",
            "type": "shell",
            "command": "cargo +nightly run --no-default-features --features renderer-wgpu",
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },

        {
            "label": "Rust: Test (wgpu)",
            "type": "shell",
            "command": "cargo +nightly test --no-default-features --features renderer-wgpu",
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": [
                "$rustc"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },

        {
            "label": "Rust: Clippy",
            "type": "shell",
            "command": "cargo +nightly clippy --no-default-features --features renderer-wgpu -- -D warnings",
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "problemMatcher": [
                "$rustc"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "Rust: Build",
            "type": "shell",
            "command": "cargo +nightly build --no-default-features --features renderer-wgpu",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$rustc"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        }
    ]
}
