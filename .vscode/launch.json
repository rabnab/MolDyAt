            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": [
                    "test",
                    "-p", "rust_thermo_wgpu"
                ]
            }
        },
        {
            "name": "Debug All Tests",
            "type": "lldb",
            "request": "launch",
            "cargo": {
